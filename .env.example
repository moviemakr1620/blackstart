# Blackstart — copy to .env and edit.
# Never commit the real file.

# App
BLACKSTART_SECRET_KEY=change-me-to-a-long-random-string
BLACKSTART_DATA_DIR=/data
BLACKSTART_HOST=0.0.0.0
BLACKSTART_PORT=8088

# First-run admin (created only if no users exist)
BLACKSTART_ADMIN_USER=admin
BLACKSTART_ADMIN_PASSWORD=blackstart

# Optional: default UPS source (also configurable in the UI)
BLACKSTART_PEANUT_URL=http://192.168.1.50:8080
BLACKSTART_PEANUT_USER=
BLACKSTART_PEANUT_PASSWORD=
BLACKSTART_NUT_HOST=192.168.1.50
BLACKSTART_NUT_PORT=3493
BLACKSTART_NUT_DEVICE=ecoflow
BLACKSTART_NUT_USER=
BLACKSTART_NUT_PASSWORD=

# Safety: live actions are OFF until you enable them in Settings
BLACKSTART_LIVE_ACTIONS=false
