# Copied to /etc/blackstart.env by install-lxc.sh
# Signs logins and encrypts stored credentials. install-lxc.sh fills this with a
# random value. Leave blank to have Blackstart generate <data dir>/secret.key.
# Placeholder values such as "change-me" are refused.
BLACKSTART_SECRET_KEY=
BLACKSTART_ADMIN_USER=admin
# Only used when the first admin is created. Leave blank and Blackstart writes a
# random password to <data dir>/initial-admin-password.txt; you must change it
# at first login either way.
BLACKSTART_ADMIN_PASSWORD=
BLACKSTART_DATA_DIR=/var/lib/blackstart
BLACKSTART_PORT=8088

# Optional — pre-seed a PeaNUT / NUT source (also configurable in the UI)
BLACKSTART_PEANUT_URL=
BLACKSTART_PEANUT_USER=
BLACKSTART_PEANUT_PASSWORD=
BLACKSTART_NUT_HOST=
BLACKSTART_NUT_PORT=3493
BLACKSTART_NUT_DEVICE=ecoflow
BLACKSTART_LIVE_ACTIONS=false
